{
  "name": "namma-metro-digital-twin",
  "version": "1.0.0",
  "description": "Interactive digital twin of Bangalore's Namma Metro network with real estate analysis",
  "type": "module",
  "scripts": {
    "start": "node server/proxy.js",
    "dev": "node server/proxy.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:screenshots": "playwright test --project=chromium",
    "test:report": "playwright show-report"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
